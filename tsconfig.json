{
  "compilerOptions": {
    // What the code can use: modern JavaScript plus browser APIs (document, window, ...).
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],

    // How strict the checks are.
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    // Only check types; Vite does the actual compiling.
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["src", "vite.config.ts"]
}
